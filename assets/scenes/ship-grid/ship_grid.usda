#usda 1.0
(
    defaultPrim = "ShipGrid"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ShipGrid" (
    customData = {
        string environmentType = "ship-grid"
    }
    doc = "Static ship-plate grid, exported without robots. Origin: deck top at grid centre."
)
{
    def Scope "Looks"
    {
        def Material "deck"
        {
            token outputs:surface.connect = </ShipGrid/Looks/deck/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.46, 0.47)
                color3f inputs:diffuseColor.connect = </ShipGrid/Looks/deck/Texture.outputs:rgb>
                float inputs:metallic = 0.4
                float inputs:roughness = 0.8
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Repeat"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </ShipGrid/Looks/deck/UV.outputs:result>
                float2 inputs:scale = (3, 3)
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/steel_base.png@
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </ShipGrid/Looks/deck/Repeat.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "flange"
        {
            token outputs:surface.connect = </ShipGrid/Looks/flange/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.52, 0.6, 0.59)
                color3f inputs:diffuseColor.connect = </ShipGrid/Looks/flange/Texture.outputs:rgb>
                float inputs:metallic = 0.5
                float inputs:roughness = 0.72
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Repeat"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </ShipGrid/Looks/flange/UV.outputs:result>
                float2 inputs:scale = (8, 8)
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/steel_base.png@
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </ShipGrid/Looks/flange/Repeat.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "web"
        {
            token outputs:surface.connect = </ShipGrid/Looks/web/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.25, 0.23)
                color3f inputs:diffuseColor.connect = </ShipGrid/Looks/web/Texture.outputs:rgb>
                float inputs:metallic = 0.5
                float inputs:roughness = 0.72
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Repeat"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </ShipGrid/Looks/web/UV.outputs:result>
                float2 inputs:scale = (8, 8)
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/steel_upright.png@
                float4 inputs:scale = (1, 1, 1, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </ShipGrid/Looks/web/Repeat.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "cut"
        {
            token outputs:surface.connect = </ShipGrid/Looks/cut/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.76, 0.75)
                float inputs:metallic = 0.75
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "surround"
        {
            token outputs:surface.connect = </ShipGrid/Looks/surround/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.25, 0.28)
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                token outputs:surface
            }
        }

        def Material "SteelContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0
            float physics:staticFriction = 0.65
        }
    }

    def Xform "Parts"
